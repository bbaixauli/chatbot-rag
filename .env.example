# Copia este fichero a backend/.env y ajusta los valores.

# development | test | production
CHATBOT_ENVIRONMENT=development
CHATBOT_LOG_LEVEL=INFO

# Carpeta de datos (SQLite, índice vectorial y ficheros subidos)
CHATBOT_DATA_DIR=../data

# Opcional: por defecto sqlite+aiosqlite:///<DATA_DIR>/app.db
# CHATBOT_DATABASE_URL=

# --- Modelo de lenguaje (servidor compatible con la API de OpenAI) ---
# openai: servidor real | fake: modelo simulado sin red (tests y demos)
CHATBOT_LLM_PROVIDER=openai
CHATBOT_LLM_BASE_URL=http://servidor-ia:8000/v1
CHATBOT_LLM_API_KEY=not-needed
CHATBOT_LLM_MODEL=llama3.1
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_LLM_TIMEOUT_SECONDS=120
CHATBOT_LLM_MAX_RETRIES=2

# --- Embeddings (búsqueda semántica en los documentos) ---
# openai: endpoint /v1/embeddings (p. ej. el proxy LiteLLM)
# local:  sentence-transformers en este servidor (requiere `uv sync --extra local-embeddings`)
# fake:   simulado, solo para tests y demos
CHATBOT_EMBEDDING_PROVIDER=openai
# Nombre del modelo tal como lo expone LiteLLM (model_name en su config.yaml)
CHATBOT_EMBEDDING_MODEL=bge-m3
# Por defecto se usan CHATBOT_LLM_BASE_URL y CHATBOT_LLM_API_KEY
# CHATBOT_EMBEDDING_BASE_URL=
# CHATBOT_EMBEDDING_API_KEY=
CHATBOT_EMBEDDING_BATCH_SIZE=32

# --- Documentos ---
CHATBOT_UPLOAD_MAX_MB=50
# Tamaño de los fragmentos indexados y solapamiento entre ellos (en caracteres)
CHATBOT_CHUNK_SIZE_CHARS=3000
CHATBOT_CHUNK_OVERLAP_CHARS=400

# --- Recuperación (RAG) ---
CHATBOT_RAG_ENABLED=true
# Fragmentos máximos que se recuperan por pregunta
CHATBOT_RAG_TOP_K=5
# Similitud mínima (0-1) para usar un fragmento; ajústala según el modelo de embeddings
CHATBOT_RAG_MIN_SCORE=0.3
# Máximo de caracteres de contexto enviados al modelo (según su ventana de contexto)
CHATBOT_RAG_MAX_CONTEXT_CHARS=12000

# --- Conversación ---
# Mensajes previos que se envían al modelo como contexto
CHATBOT_CHAT_HISTORY_MAX_MESSAGES=20
CHATBOT_CHAT_MAX_MESSAGE_LENGTH=8000

# --- Administración ---
# Sin contraseña, la zona de administración queda deshabilitada.
CHATBOT_ADMIN_USERNAME=admin
CHATBOT_ADMIN_PASSWORD=cambia-esta-contraseña
# Clave para firmar la cookie de sesión (genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Si no se define, se genera al arrancar y las sesiones se pierden al reiniciar.
CHATBOT_SESSION_SECRET=
CHATBOT_SESSION_MAX_AGE_SECONDS=28800
# true cuando se sirva por HTTPS
CHATBOT_SESSION_COOKIE_SECURE=false
