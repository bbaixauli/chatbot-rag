# Copia este fichero a backend/.env (desarrollo) o a .env en la raíz (Docker, ver
# docs/despliegue.md) y ajusta los valores.

# development | test | production
CHATBOT_ENVIRONMENT=development
CHATBOT_LOG_LEVEL=INFO
# text (consola) | json (una línea por evento; es el valor por defecto en la imagen Docker)
CHATBOT_LOG_FORMAT=text

# Carpeta de datos (SQLite, índice vectorial y ficheros subidos)
CHATBOT_DATA_DIR=../data

# Opcional: por defecto sqlite+aiosqlite:///<DATA_DIR>/app.db
# CHATBOT_DATABASE_URL=

# --- Modelo de lenguaje (servidor compatible con la API de OpenAI) ---
# openai: servidor real | fake: modelo simulado sin red (tests y demos)
CHATBOT_LLM_PROVIDER=openai
CHATBOT_LLM_BASE_URL=http://servidor-ia:8000/v1
CHATBOT_LLM_API_KEY=not-needed
CHATBOT_LLM_MODEL=llama3.1
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_LLM_TIMEOUT_SECONDS=120
CHATBOT_LLM_MAX_RETRIES=2

# --- Embeddings (búsqueda semántica en los documentos) ---
# openai: endpoint /v1/embeddings (p. ej. el proxy LiteLLM)
# local:  sentence-transformers en este servidor (requiere `uv sync --extra local-embeddings`)
# fake:   simulado, solo para tests y demos
CHATBOT_EMBEDDING_PROVIDER=openai
# Nombre del modelo tal como lo expone LiteLLM (model_name en su config.yaml)
CHATBOT_EMBEDDING_MODEL=bge-m3
# Por defecto se usan CHATBOT_LLM_BASE_URL y CHATBOT_LLM_API_KEY
# CHATBOT_EMBEDDING_BASE_URL=
# CHATBOT_EMBEDDING_API_KEY=
CHATBOT_EMBEDDING_BATCH_SIZE=32

# --- Documentos ---
CHATBOT_UPLOAD_MAX_MB=50
# Tamaño de los fragmentos indexados y solapamiento entre ellos (en caracteres)
CHATBOT_CHUNK_SIZE_CHARS=3000
CHATBOT_CHUNK_OVERLAP_CHARS=400

# --- Recuperación (RAG) ---
CHATBOT_RAG_ENABLED=true
# Fragmentos máximos que se recuperan por pregunta
CHATBOT_RAG_TOP_K=5
# Similitud mínima (0-1) para usar un fragmento; ajústala según el modelo de embeddings
CHATBOT_RAG_MIN_SCORE=0.3
# Máximo de caracteres de contexto enviados al modelo (según su ventana de contexto)
CHATBOT_RAG_MAX_CONTEXT_CHARS=12000
# Reescribe las preguntas de seguimiento («¿y en agosto?») como preguntas completas antes de
# buscar. Cuesta una llamada extra al modelo cuando hay historial y documentos indexados.
CHATBOT_RAG_CONDENSE_QUESTION=true
CHATBOT_RAG_CONDENSE_HISTORY_MESSAGES=6

# --- Conversación ---
# Mensajes previos que se envían al modelo como contexto
CHATBOT_CHAT_HISTORY_MAX_MESSAGES=20
CHATBOT_CHAT_MAX_MESSAGE_LENGTH=8000
# Límites del mensaje inicial y de cada pregunta sugerida (Administración → Mensaje inicial)
CHATBOT_CHAT_WELCOME_MAX_LENGTH=2000
CHATBOT_CHAT_SUGGESTED_QUESTION_MAX_LENGTH=300

# --- Usuarios (ver docs/despliegue.md, sección LDAP) ---
# none: chat anónimo con un único historial | ldap: cada usuario inicia sesión y ve sus conversaciones
CHATBOT_AUTH_MODE=none
# ldaps://servidor:636, o ldap://servidor:389 con CHATBOT_LDAP_START_TLS=true
# CHATBOT_LDAP_URL=ldaps://ldap.ejemplo.org:636
# CHATBOT_LDAP_START_TLS=false
# Certificado de la CA del directorio si no está en el almacén del sistema
# CHATBOT_LDAP_CA_CERT_FILE=/data/ldap-ca.pem
# Cuenta de servicio para buscar usuarios (vacía = búsqueda anónima)
# CHATBOT_LDAP_BIND_DN=cn=chatbot,ou=services,dc=ejemplo,dc=org
# CHATBOT_LDAP_BIND_PASSWORD=
# CHATBOT_LDAP_USER_BASE_DN=ou=people,dc=ejemplo,dc=org
# OpenLDAP: (uid={username}) | Active Directory: (sAMAccountName={username})
# CHATBOT_LDAP_USER_FILTER=(uid={username})
# CHATBOT_LDAP_USER_ID_ATTRIBUTE=uid
# CHATBOT_LDAP_DISPLAY_NAME_ATTRIBUTE=cn
# Los miembros de este grupo administran la aplicación
# CHATBOT_LDAP_ADMIN_GROUP_DN=cn=chatbot-admins,ou=groups,dc=ejemplo,dc=org
# Solo Active Directory: tener en cuenta grupos anidados
# CHATBOT_LDAP_NESTED_GROUPS=false

# --- Escalado (ver docs/despliegue.md, sección «Escalado») ---
# chroma: índice embebido | qdrant: servidor Qdrant (requiere el extra `escalado`)
CHATBOT_VECTOR_STORE=chroma
# CHATBOT_QDRANT_URL=http://qdrant:6333
# CHATBOT_QDRANT_API_KEY=
# CHATBOT_QDRANT_COLLECTION=chatbot_chunks
# inprocess: indexación en la API | arq: cola en Redis con workers (requiere qdrant)
CHATBOT_TASK_RUNNER=inprocess
# CHATBOT_REDIS_URL=redis://redis:6379/0
# Documentos que indexa a la vez cada proceso (API o worker)
CHATBOT_INDEXING_CONCURRENCY=2

# --- Límite de peticiones por IP y minuto (0 = sin límite) ---
CHATBOT_RATE_LIMIT_CHAT_PER_MINUTE=20
CHATBOT_RATE_LIMIT_LOGIN_PER_MINUTE=5

# --- Administración ---
# Sin contraseña, la zona de administración queda deshabilitada.
CHATBOT_ADMIN_USERNAME=admin
CHATBOT_ADMIN_PASSWORD=cambia-esta-contraseña
# Clave para firmar la cookie de sesión (genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Si no se define, se genera al arrancar y las sesiones se pierden al reiniciar.
CHATBOT_SESSION_SECRET=
CHATBOT_SESSION_MAX_AGE_SECONDS=28800
# true cuando se sirva por HTTPS
CHATBOT_SESSION_COOKIE_SECURE=false
