# Copia este fichero a backend/.env (desarrollo) o a .env en la raíz (Docker, ver
# docs/despliegue.md) y ajusta los valores.

# development | test | production
CHATBOT_ENVIRONMENT=development
CHATBOT_LOG_LEVEL=INFO
# Zona horaria de las fechas y de los días del cuadro de mando
CHATBOT_TIMEZONE=Europe/Madrid
# text (consola) | json (una línea por evento; es el valor por defecto en la imagen Docker)
CHATBOT_LOG_FORMAT=text

# Carpeta de datos (SQLite, índice vectorial y ficheros subidos)
CHATBOT_DATA_DIR=../data

# Opcional: por defecto sqlite+aiosqlite:///<DATA_DIR>/app.db
# PostgreSQL (ver docs/despliegue.md, sección «Base de datos PostgreSQL»):
# postgresql+asyncpg://usuario@servidor:5432/basededatos, con la contraseña aparte (sin
# codificar caracteres especiales y sin que aparezca al mostrar la URL). Con el contenedor de
# docker-compose.postgres.yml: postgresql+asyncpg://chatbot@postgres:5432/chatbot
# CHATBOT_DATABASE_URL=
# CHATBOT_DATABASE_PASSWORD=
# Servidor externo con ?ssl=verify-full en la URL: CA de su certificado, en el volumen de datos
# PGSSLROOTCERT=/data/postgres-ca.pem

# ============================================================================================
# Valores iniciales: desde «Modelo de lenguaje» hasta «Usuarios», y los límites de
# peticiones, se copian a la base de datos en el primer arranque y después se cambian en la
# administración. A partir de entonces estas variables se ignoran (ver docs/despliegue.md,
# «Configuración de la aplicación»).
# ============================================================================================

# --- Modelo de lenguaje (servidor compatible con la API de OpenAI) ---
# openai: servidor real | fake: modelo simulado sin red (tests y demos)
CHATBOT_LLM_PROVIDER=openai
CHATBOT_LLM_BASE_URL=http://servidor-ia:8000/v1
CHATBOT_LLM_API_KEY=not-needed
CHATBOT_LLM_MODEL=llama3.1
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_LLM_TIMEOUT_SECONDS=120
CHATBOT_LLM_MAX_RETRIES=2
# Ventana de contexto del modelo en el servidor (num_ctx en Ollama, --max-model-len en
# vLLM) y lo que se reserva de ella para la respuesta. Con la ventana, el prompt se ajusta
# a ella antes de enviarlo; 0: no se comprueba (el servidor podría recortarlo sin avisar)
CHATBOT_LLM_CONTEXT_WINDOW_TOKENS=0
CHATBOT_LLM_RESPONSE_RESERVE_TOKENS=1024

# --- Embeddings (búsqueda semántica en los documentos) ---
# openai: endpoint /v1/embeddings (p. ej. el proxy LiteLLM)
# local:  sentence-transformers en este servidor (requiere `uv sync --extra local-embeddings`)
# fake:   simulado, solo para tests y demos
CHATBOT_EMBEDDING_PROVIDER=openai
# Nombre del modelo tal como lo expone LiteLLM (model_name en su config.yaml)
CHATBOT_EMBEDDING_MODEL=bge-m3
# Por defecto se usan CHATBOT_LLM_BASE_URL y CHATBOT_LLM_API_KEY
# CHATBOT_EMBEDDING_BASE_URL=
# CHATBOT_EMBEDDING_API_KEY=
CHATBOT_EMBEDDING_BATCH_SIZE=32

# --- Documentos ---
CHATBOT_UPLOAD_MAX_MB=50
# Tamaño de los fragmentos indexados y solapamiento entre ellos (en caracteres)
CHATBOT_CHUNK_SIZE_CHARS=3000
CHATBOT_CHUNK_OVERLAP_CHARS=400
# Limpieza del texto antes de indexar (cambiarla obliga a reindexar):
# quita de los PDF las líneas repetidas en al menos esa proporción de páginas (sellos, pies…)
CHATBOT_INDEXING_STRIP_REPEATED_LINES=true
CHATBOT_INDEXING_REPEATED_LINE_MIN_RATIO=0.5
# quita los puntos de relleno de los índices («Objetivo ...... 5»)
CHATBOT_INDEXING_CLEAN_TOC_LEADERS=true
# busca cada fragmento con el título del documento y la sección delante
CHATBOT_INDEXING_CONTEXT_PREFIX=true
# detecta los apartados numerados de los PDF («4.2 Altas») como sección de los fragmentos
CHATBOT_INDEXING_PDF_HEADINGS=true

# --- Documentos web (añadidos por su dirección) ---
# Tiempo máximo de cada descarga, en segundos
CHATBOT_WEB_TIMEOUT_SECONDS=30
# Dominios de los que se pueden añadir documentos, separados por comas (cada uno con sus
# subdominios); vacío: cualquiera
# CHATBOT_WEB_ALLOWED_DOMAINS=intranet.ejemplo.org,ejemplo.org
# Comprueba periódicamente si han cambiado (cada N horas) y los borra si no se encuentran
# (404 o 410) en N comprobaciones seguidas
CHATBOT_WEB_REFRESH_ENABLED=true
CHATBOT_WEB_REFRESH_INTERVAL_HOURS=24
CHATBOT_WEB_NOT_FOUND_LIMIT=3

# --- Certificados (conexiones HTTPS con webs, modelo de lenguaje y embeddings) ---
# Comprobación X.509 estricta (RFC 5280). Desactívala si los certificados de la organización
# no la superan (p. ej. les falta el Authority Key Identifier). Los certificados de una CA
# propia se añaden en Administración → Configuración → Certificados.
CHATBOT_TLS_STRICT_X509=true

# --- Recuperación (RAG) ---
CHATBOT_RAG_ENABLED=true
# Fragmentos máximos que se recuperan por pregunta
CHATBOT_RAG_TOP_K=5
# Similitud mínima (0-1) para usar un fragmento; ajústala según el modelo de embeddings
CHATBOT_RAG_MIN_SCORE=0.3
# Máximo de caracteres de contexto enviados al modelo (según su ventana de contexto)
CHATBOT_RAG_MAX_CONTEXT_CHARS=12000
# Reescribe las preguntas de seguimiento («¿y en agosto?») como preguntas completas antes de
# buscar. Cuesta una llamada extra al modelo cuando hay historial y documentos indexados.
CHATBOT_RAG_CONDENSE_QUESTION=true
CHATBOT_RAG_CONDENSE_HISTORY_MESSAGES=6
# Multiplica la puntuación de los fragmentos que parecen el índice del documento (1 = igual)
CHATBOT_RAG_TOC_SCORE_FACTOR=0.8
# Puntuación mínima cuando la búsqueda se limita a unos documentos (0 = basta con el top-k)
CHATBOT_RAG_SCOPED_MIN_SCORE=0
# Busca solo en los documentos que nombre la pregunta (por su código, p. ej. NOR-013, o título)
CHATBOT_RAG_DETECT_DOCUMENT_NAMES=true
# Fragmentos anteriores y posteriores que se añaden a cada fragmento recuperado (0-3)
CHATBOT_RAG_NEIGHBOR_CHUNKS=0
# Si la búsqueda se limita a un solo documento y cabe en estos caracteres, se envía completo
# (0 = nunca). Debe caber en la ventana de contexto del modelo de chat (~4 caracteres/token).
CHATBOT_RAG_FULL_DOCUMENT_MAX_CHARS=0
# Si la pregunta cita un apartado («el apartado 4.2») y la búsqueda está limitada a unos
# documentos, se añade el apartado completo
CHATBOT_RAG_LOCATE_SECTIONS=true

# --- Conversación ---
# Mensajes previos que se envían al modelo como contexto
CHATBOT_CHAT_HISTORY_MAX_MESSAGES=20
CHATBOT_CHAT_MAX_MESSAGE_LENGTH=8000
# Límites del mensaje inicial y de cada pregunta sugerida (Administración → Mensaje inicial)
CHATBOT_CHAT_WELCOME_MAX_LENGTH=2000
CHATBOT_CHAT_SUGGESTED_QUESTION_MAX_LENGTH=300

# --- Usuarios (valores iniciales; ver docs/despliegue.md, sección LDAP) ---
# none: chat anónimo con un único historial | ldap: cada usuario inicia sesión y ve sus conversaciones
CHATBOT_AUTH_MODE=none
# ldaps://servidor:636, o ldap://servidor:389 con CHATBOT_LDAP_START_TLS=true
# CHATBOT_LDAP_URL=ldaps://ldap.ejemplo.org:636
# CHATBOT_LDAP_START_TLS=false
# Fichero con el certificado de la CA del directorio si no está en el almacén del sistema.
# No es un valor inicial: sigue aquí y se lee en cada conexión.
# CHATBOT_LDAP_CA_CERT_FILE=/data/ldap-ca.pem
# Cuenta de servicio para buscar usuarios (vacía = búsqueda anónima)
# CHATBOT_LDAP_BIND_DN=cn=chatbot,ou=services,dc=ejemplo,dc=org
# CHATBOT_LDAP_BIND_PASSWORD=
# CHATBOT_LDAP_USER_BASE_DN=ou=people,dc=ejemplo,dc=org
# OpenLDAP: (uid={username}) | Active Directory: (sAMAccountName={username})
# CHATBOT_LDAP_USER_FILTER=(uid={username})
# CHATBOT_LDAP_USER_ID_ATTRIBUTE=uid
# CHATBOT_LDAP_DISPLAY_NAME_ATTRIBUTE=cn
# Los miembros de este grupo administran la aplicación
# CHATBOT_LDAP_ADMIN_GROUP_DN=cn=chatbot-admins,ou=groups,dc=ejemplo,dc=org
# Los miembros de este grupo acceden a la auditoría. Sin él, la auditoría es de los
# administradores
# CHATBOT_LDAP_AUDITOR_GROUP_DN=cn=chatbot-auditores,ou=groups,dc=ejemplo,dc=org
# Solo Active Directory: tener en cuenta grupos anidados
# CHATBOT_LDAP_NESTED_GROUPS=false

# --- Escalado (ver docs/despliegue.md, sección «Escalado») ---
# chroma: índice embebido | qdrant: servidor Qdrant (requiere el extra `escalado`)
CHATBOT_VECTOR_STORE=chroma
# CHATBOT_QDRANT_URL=http://qdrant:6333
# CHATBOT_QDRANT_API_KEY=
# CHATBOT_QDRANT_COLLECTION=chatbot_chunks
# inprocess: indexación en la API | arq: cola en Redis con workers (requiere qdrant)
CHATBOT_TASK_RUNNER=inprocess
# CHATBOT_REDIS_URL=redis://redis:6379/0
# Documentos que indexa a la vez cada proceso (API o worker)
CHATBOT_INDEXING_CONCURRENCY=2

# --- Límite de peticiones por IP y minuto (0 = sin límite; valores iniciales) ---
CHATBOT_RATE_LIMIT_CHAT_PER_MINUTE=20
CHATBOT_RATE_LIMIT_LOGIN_PER_MINUTE=5

# --- Auditoría (valores iniciales; después se cambian en la administración) ---
# Revisión periódica: hourly (cada hora) o daily (a diario a la hora indicada)
CHATBOT_AUDIT_ENABLED=true
CHATBOT_AUDIT_SCHEDULE=daily
CHATBOT_AUDIT_DAILY_TIME=02:00
# Revisar también con el modelo (además de las reglas); vacío = el modelo del chat
CHATBOT_AUDIT_USE_LLM=true
# CHATBOT_AUDIT_LLM_MODEL=
CHATBOT_AUDIT_MAX_PER_RUN=500
CHATBOT_AUDIT_LLM_HISTORY_DAYS=7
# Días tras los que se anonimizan usuario, IP y navegador (0 = nunca)
CHATBOT_AUDIT_RETENTION_DAYS=365
# Alerta si una revisión encuentra al menos estas preguntas sin poder consultar la
# documentación (embeddings o índice caídos); 0 = sin alerta
CHATBOT_AUDIT_RETRIEVAL_FAILURE_THRESHOLD=10
# Avisos por correo
CHATBOT_AUDIT_NOTIFY_ENABLED=false
CHATBOT_AUDIT_NOTIFY_MIN_SEVERITY=medium
# CHATBOT_AUDIT_NOTIFY_TO=seguridad@ejemplo.es,auditoria@ejemplo.es
# CHATBOT_AUDIT_SMTP_HOST=smtp.ejemplo.es
# CHATBOT_AUDIT_SMTP_PORT=587
# starttls | ssl | plain (sin cifrar)
# CHATBOT_AUDIT_SMTP_SECURITY=starttls
# CHATBOT_AUDIT_SMTP_USERNAME=
# CHATBOT_AUDIT_SMTP_PASSWORD=
# CHATBOT_AUDIT_SMTP_FROM=chatbot@ejemplo.es

# --- Administración ---
# Sin contraseña, la zona de administración queda deshabilitada.
# Cambia el valor de ejemplo: en producción la aplicación no arranca con él.
CHATBOT_ADMIN_USERNAME=admin
CHATBOT_ADMIN_PASSWORD=cambia-esta-contraseña
# Clave para firmar la cookie de sesión y cifrar las claves de API guardadas en la base de
# datos, de al menos 16 caracteres (genera una con:
# python -c "import secrets; print(secrets.token_urlsafe(32))").
# Si no se define, se genera al arrancar: las sesiones se pierden al reiniciar y las claves de
# API guardadas se vuelven a tomar de este fichero. En producción es obligatoria si hay
# administración o LDAP. Si la cambias, vuelve a introducir las claves de API en la
# administración.
# CHATBOT_SESSION_SECRET=
CHATBOT_SESSION_MAX_AGE_SECONDS=28800
# true cuando se sirva por HTTPS
CHATBOT_SESSION_COOKIE_SECURE=false

# --- HTTPS (ver docs/despliegue.md, sección «HTTPS») ---
# Solo con docker-compose.https.yml, que ya fija CHATBOT_SESSION_COOKIE_SECURE=true. Para no
# repetir -f en cada comando de docker compose:
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# Nombre (o IP) con el que se accede a la aplicación; varios separados por comas.
# CHATBOT_DOMAIN=chatbot.ejemplo.es
# interno: certificado autofirmado (CA interna de Caddy) | certificado: el de la organización,
# en CHATBOT_CERTS_DIR/cert.pem (con la cadena completa) y CHATBOT_CERTS_DIR/key.pem
# CHATBOT_TLS=interno
# CHATBOT_CERTS_DIR=./certs
# CHATBOT_HTTPS_PORT=443
# Puerto HTTP que solo redirige a HTTPS
# CHATBOT_HTTP_REDIRECT_PORT=80
# Tiempo (s) durante el que el navegador solo usará HTTPS (0 mientras se prueba con un
# certificado en el que los equipos aún no confían)
# CHATBOT_HSTS_MAX_AGE=31536000
# Con un proxy HTTPS propio (sin docker-compose.https.yml): IP o rangos CIDR del proxy,
# separados por espacios o comas, para conocer la IP real de los clientes.
# CHATBOT_TRUSTED_PROXIES=10.0.0.5
