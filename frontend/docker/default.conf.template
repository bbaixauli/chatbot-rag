# Plantilla de nginx: las variables CHATBOT_* se sustituyen al arrancar el contenedor.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;

    # Debe superar CHATBOT_UPLOAD_MAX_MB (subidas de varios ficheros a la vez).
    client_max_body_size ${CHATBOT_MAX_BODY_SIZE};

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${CHATBOT_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Se sustituye (no se añade) para que el cliente no pueda falsear su IP y saltarse
        # el límite de peticiones. Si hay otro proxy delante, ver docs/despliegue.md.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        # Respuestas del chat en streaming (SSE): sin búfer y con tiempo de espera amplio.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Ficheros con hash en el nombre: se pueden cachear indefinidamente.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
